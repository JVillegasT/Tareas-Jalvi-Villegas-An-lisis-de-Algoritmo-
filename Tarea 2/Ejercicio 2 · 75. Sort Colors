class Solution:
    def sortColors(self, nums: List[int]) -> None:
        j = 0
        i = 0
        k = len(nums) - 1

        while i <= k:
            if nums[i] == 0:
                nums[j], nums[i] = nums[i], nums[j]  
                j = j + 1
                i = i + 1
            elif nums[i] == 1:
                i = i + 1
            else:
                nums[i], nums[k] = nums[k], nums[i]  
                k = k - 1
