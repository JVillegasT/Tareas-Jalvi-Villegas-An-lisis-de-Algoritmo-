class Solution:
    def findContentChildren(self, g: List[int], s: List[int]) -> int:
        g.sort()# ordenamos
        s.sort()
        i = j = 0
        cont = 0
        while i < len(g) and j < len(s):
            if g[i] <= s[j]:
                ##print("Entro 1 if")
                cont += 1
                i += 1
                j += 1
            else:
                j += 1
        return cont
