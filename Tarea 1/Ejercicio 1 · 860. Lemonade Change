class Solution:
    def lemonadeChange(self, bills: List[int]) -> bool:
        five = 0
        ten = 0
        for bill in bills:
            if bill == 5:
                five += 1
                ##print("Entro 1 if")
            elif bill == 10:
                if five == 0:
                    ##print("Entro 2 if")
                    return False
                five -= 1
                ten += 1
            else:
                if five > 0 and ten > 0:
                    ten -= 1
                    five -= 1
                    ##print("Entro 3 if")
                elif five >= 3:
                    five -= 3
                else:
                    return False
        return True

